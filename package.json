{
  "name": "what-i-listen",
  "version": "0.6.1",
  "private": true,
  "license": "MIT",
  "description": "Application Electron locale pour afficher le morceau Deezer en cours dans OBS.",
  "type": "module",
  "main": ".build/electron-main.js",
  "scripts": {
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.json && node scripts/bundle-browser.mjs",
    "start": "npm run build && electron .",
    "start:service": "npm run build && node .build/src/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke:webgl": "electron scripts/smoke-webgl.cjs",
    "clean:dist": "node scripts/clean-dist.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "release": "release-it"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "electron-updater": "^6.6.2",
    "three": "^0.185.1",
    "windows-media-sessions": "1.0.3"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/three": "^0.185.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "release-it": "^21.0.2",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "fr.whatilisten.deezer",
    "productName": "What I Listen",
    "publish": {
      "provider": "github",
      "owner": "YacineRAFES",
      "repo": "What_I_Listen"
    },
    "asarUnpack": [
      "node_modules/windows-media-sessions/bin/**/*"
    ],
    "extraResources": [
      {
        "from": ".build/wasapi-capture",
        "to": "wasapi-capture",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      ".build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "What-I-Listen-Setup-${version}.${ext}"
    }
  }
}
