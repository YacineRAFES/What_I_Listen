{
  "name": "what-i-listen",
  "version": "0.2.3",
  "private": true,
  "license": "MIT",
  "description": "Application Electron locale pour afficher le morceau Deezer en cours dans OBS.",
  "type": "module",
  "main": ".build/electron-main.js",
  "scripts": {
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "start:service": "npm run build && node .build/src/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --win nsis",
    "release": "release-it"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "windows-media-sessions": "1.0.3"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "release-it": "^21.0.2",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "fr.whatilisten.deezer",
    "productName": "What I Listen",
    "asarUnpack": [
      "node_modules/windows-media-sessions/bin/**/*"
    ],
    "files": [
      ".build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
